<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        权限最小化（逐条判据与取证见 ADR-0022）：本应用只声明用得到的四项。
        已删除的都是「声明了但全仓无对应 API 调用」的遗留项：
        - ACCESS_WIFI_STATE / CHANGE_WIFI_STATE：无任何 WifiManager 用法（Wi-Fi 状态判断走 ConnectivityManager）
        - READ_PHONE_STATE / WAKE_LOCK：无 TelephonyManager、无 PowerManager.newWakeLock
        - GET_ACCOUNTS / READ_PROFILE / READ_CONTACTS：IDE 登录表单自动补全模板遗留，全仓无 AccountManager/联系人查询
        - READ_EXTERNAL_STORAGE / READ_MEDIA_IMAGES / READ_MEDIA_VISUAL_USER_SELECTED：
          相册选取走 ActivityResultContracts.PickVisualMedia（Android 13+ 免权限，低版本回落 SAF 同样免权限）
        - CAMERA：拍照走 TakePicture（由系统相机应用持权限，本应用只需 FileProvider 授权落盘 Uri）；
          声明了却从不请求的 CAMERA 在部分 OEM 上反而会让拍照 Intent 失败
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--    允许前台服务-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        相机特性**只声明不要求**：原 `android.hardware.camera` 未写 required，默认即 true，
        会把无相机的设备（部分模拟器/电视/平板）挡在安装过滤之外；本应用只是借系统相机拍照。
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <application
        android:name="com.ebook.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Common"
        android:usesCleartextTraffic="true"
        tools:targetApi="s" />
</manifest>