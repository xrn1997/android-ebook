<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        独立运行模式（isModule=true）专用 Manifest。
        注意：业务 Activity 声明与 src/main/AndroidManifest.xml（library 集成模式）
        重复，新增/重命名/改 label 的页面时两处必须同步修改。
    -->
    <!--
        本模块**不声明任何权限**（判据见 ADR-0022）：头像流程相册走 PickVisualMedia
        （免权限，系统按所选条目授予读取权）、拍照走 TakePicture + FileProvider 授权落盘 Uri，
        均不需要 READ_MEDIA_*/READ_EXTERNAL_STORAGE。
        此前本文件带着集成清单（src/main/AndroidManifest.xml）没有的四项存储权限，
        正是 AGENTS.md 禁止的「两份清单权限面分裂」，已删至与集成清单一致。
    -->
    <application
        android:name="debug.TestApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Common">
        <activity
            android:name="debug.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.SettingActivity"
            android:label="@string/setting_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.CacheManageActivity"
            android:label="@string/cache_manage_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.AboutActivity"
            android:label="@string/about_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.DocActivity"
            android:label="@string/doc_activity_label"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.LicensesActivity"
            android:label="@string/licenses_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.MyCommentActivity"
            android:label="@string/my_comment_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.ModifyInformationActivity"
            android:label="@string/modify_info_title"
            android:theme="@style/ToolbarTheme.BackBar" />
        <activity
            android:name=".view.ModifyNicknameActivity"
            android:label="@string/modify_nickname_title"
            android:theme="@style/ToolbarTheme.BackBar" />

        <activity
            android:name=".view.profilePhoto.ClipImageActivity"
            android:label="@string/clip_activity_label"
            android:theme="@style/ToolbarTheme.BackBar" />

        <activity android:name="debug.LoginActivity" />
    </application>

</manifest>
