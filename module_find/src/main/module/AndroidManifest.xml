<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        权限判据与取证见 ADR-0022。本文件（isModule=true 独立模式）与
        src/main/AndroidManifest.xml（集成模式）**必须逐条一致**——两份是替换关系，
        独立运行时只生效本文件。本模块只做书城/搜索/书库浏览（网络抓取 + Room），
        不碰 Wi-Fi/定位/电话状态/WakeLock/账号/联系人/相机，也不做文件导入
        （存储权限归 module_book 的导入本地书链路）；相机特性的显式声明留在 module_app。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="debug.TestApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Common">
        <activity
            android:name="debug.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ChoiceBookActivity" />
        <activity
            android:name=".SearchActivity"
            android:configChanges="locale|keyboardHidden|orientation|screenSize"
            android:theme="@style/ToolbarTheme.BackBar"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name="debug.TestDetailActivity" />
    </application>

</manifest>