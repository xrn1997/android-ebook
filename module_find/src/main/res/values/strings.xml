<resources>
    <string name="app_name">module_find</string>
    <!-- 异常无 message 时的兜底文案（VM 侧引用，不得硬编码在代码里） -->
    <string name="network_request_timeout">网络请求超时</string>
    <string name="search_book_or_author">搜书名、作者</string>
    <string name="str_return">返回</string>
    <string name="str_search_history">搜索历史</string>
    <string name="str_clean">清除</string>
    <string name="please_input_author_or_work">请输入作品名或作者名</string>
    <string name="bookstore_title">书城</string>
    <string name="book_type">书籍类型</string>
    <string name="search_hint">请输入书名/作者</string>
    <string name="more">更多</string>
    <!-- 列表项加书架是图标按钮，文案不上屏、只作无障碍名，故写成动作/状态而不是「+添加」 -->
    <string name="add_to_shelf">加入书架</string>
    <string name="already_on_shelf">已在书架</string>
    <string name="search">搜索</string>
    <!-- 按书绑源（ADR-0016）：加入书架时这本书归属的书源已被删除/规则读不出。
         异常自身消息形如「书源已失效：<URL>」，不带行动指引也不该上屏，故走资源 -->
    <string name="book_source_invalid">书源已失效，请重新导入或换源</string>
    <!-- 聚合搜索（ADR-0016 P3-b）的书源进度：分母是本轮参与的书源数，失败的源同样会计入
         「已结束」，所以这条文案不会因某个站点挂掉而永远停在 X<Y；全部源结束即整行消失 -->
    <string name="search_source_progress">已收到 %1$d/%2$d 书源结果</string>
    <!-- 书城顶部书源切换器（ADR-0016 P3-c）：胶囊本身显示的就是书源名，故这里只有无障碍与引导态文案。
         contentDescription 走资源而不是硬编码，与本仓其它图标一致 -->
    <string name="switch_book_source">切换书源</string>
    <string name="current_book_source">当前书源</string>
    <!-- 用户把书源全部禁用：书城一条数据都不该发（没有源可解析），只给一句能自己走通的话 -->
    <string name="no_book_source_title">还没有可用书源</string>
    <string name="no_book_source_guidance">请先在书源管理中启用或导入书源</string>
    <!-- 引导态里的行动入口按钮：跟着上面那句一起出现，把「去哪导入」这一步直接递到手上 -->
    <string name="go_import_book_source">去导入书源</string>
    <!-- 有源但当前这个源解析不出来（行被删/规则读不出）：与上面两条是**不同的动作**，
         误报成「没源」会把用户支去启用那条本就坏掉的源（ADR-0016 决策 5 要求的提示） -->
    <string name="broken_book_source_title">当前书源已失效</string>
    <string name="broken_book_source_guidance">这个源已经解析不出来了，可在上方换一个书源，或到书源管理中重新导入该书源</string>
    <!-- 从 module_me 迁入：书源管理页的专属文案，随页面归位 -->
    <!-- ===== 书源管理页 ===== -->
    <string name="book_source_title">书源管理</string>
    <!-- 汇总行：第一个数是清单总数（含禁用），第二个是启用数 -->
    <string name="book_source_summary">共 %1$d 个书源，已启用 %2$d 个</string>
    <string name="book_source_import">导入</string>
    <string name="book_source_export">导出全部</string>
    <string name="book_source_export_one">导出该书源</string>
    <string name="book_source_unnamed">未命名书源</string>
    <!-- 一次性提示 -->
    <string name="book_source_read_failed">无法读取所选文件</string>
    <string name="book_source_import_unreadable">未能从该文件读出书源，请确认它是书源 JSON（单条对象或数组）</string>
    <string name="book_source_export_empty">没有可导出的书源</string>
    <string name="book_source_export_success">已导出书源文件</string>
    <string name="book_source_export_failed">导出失败，请重试</string>
    <string name="book_source_empty_title">暂无书源</string>
    <string name="book_source_empty_hint">可导入 JSON</string>
    <!-- 行操作层 -->
    <string name="book_source_default_badge">默认</string>
    <!-- 出身标记：答的是「这条是哪种格式」，与上面那个状态标记不同维度。脚本行与原生行在清单里
         长得几乎一样，能力差别（不进书城与聚合搜索、暂时也不能导出）却要到最后一步才看得出来，
         所以必须在行上说清 -->
    <string name="book_source_script_badge">脚本</string>
    <string name="book_source_set_default">设为默认</string>
    <string name="book_source_delete">删除该书源</string>
    <string name="book_source_delete_title">删除书源</string>
    <!-- 删除只动清单、不动书架：这句要说清两件事，否则用户以为藏书一起没了 -->
    <string name="book_source_delete_confirm">确定删除「%1$s」？删除后它不再参与搜索与书城，书架上归属它的书仍在，但需重新导入该书源才能继续解析。</string>
    <string name="book_source_delete_missing">该书源已不在清单中</string>
    <!-- 导入预览弹层 -->
    <string name="book_source_preview_title">导入预览</string>
    <!-- 第二个数是校验不通过的条数：先讲清「这一包里有多少条进不来」 -->
    <string name="book_source_preview_desc">共 %1$d 条，其中 %2$d 条校验不通过、不会被导入</string>
    <string name="book_source_import_confirm">确认导入 %1$d 条</string>
    <!-- 统计口径：成功含覆盖，失败 = 校验未通过 + 写库失败（写库失败的具体原因另经 reportFailure 上报） -->
    <string name="book_source_import_result">导入成功 %1$d 条 / 覆盖 %2$d 条 / 失败 %3$d 条</string>
    <string name="book_source_will_overwrite">将覆盖</string>
    <!-- 同一条 URL 换出身（原生规则书源 ↔ 脚本书源）后，它在书城/搜索里的参与方式会整片变掉，
         只说「将覆盖」会让人以为只是改了改规则，故这两条把「被换掉的是哪种出身」写进标记里 -->
    <string name="book_source_will_overwrite_script">将覆盖脚本书源</string>
    <string name="book_source_will_overwrite_native">将覆盖原生规则书源</string>
    <string name="book_source_validation_pass">校验通过</string>
    <string name="book_source_validation_fail">校验不通过</string>
    <!-- 原生规则书源的四条结构校验失败原因，与 BookSourceValidator.validate 的四条一一对应；
         脚本书源共用前两查，它专属的那条原因在下面单独一块 -->
    <string name="book_source_reason_name_blank">书源名称为空</string>
    <string name="book_source_reason_url_not_http">书源地址必须以 http:// 或 https:// 开头</string>
    <string name="book_source_reason_no_entry">缺少入口地址：搜索地址与发现页地址至少要有一个，否则搜索和书城都用不上</string>
    <string name="book_source_reason_no_parse_rule">缺少解析规则：搜索结果列表与正文容器的选择器都不能为空</string>
    <!-- 脚本书源整块读不出来。预览与落库用的是同一个解码器，所以「预览说能导」与「确实存得下去」
         是同一件事，不会出现点了确认才发现存不下。
         文案要说清「只丢这一条」：一整包里坏一条时用户最怕的是整包作废 -->
    <string name="book_source_reason_script_unparsable">脚本书源 JSON 无法解析：字段值与该格式对不上，这一条不会被导入（其余条目不受影响）</string>
    <!-- 脚本书源的三项导入警示：只要求知情，不拦导入（ADR-0029 决策 6） -->
    <string name="book_source_warning_executable_code">含可执行脚本代码（将在零权限隔离环境中运行）</string>
    <string name="book_source_warning_needs_login">依赖登录流程，登录相关功能暂不可用</string>
    <string name="book_source_warning_not_text">漫画/音频类书源，本项目为文字阅读器，可能无法正常阅读</string>
</resources>
